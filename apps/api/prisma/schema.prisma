generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CASHIER
  MAKER
  OWNER
}

enum TicketStatus {
  DRAFT
  PENDING_PAYMENT
  ORDERED
  IN_PROGRESS
  READY
  COMPLETED
  CANCELLED
}

enum SubTicketStatus {
  ORDERED
  IN_PROGRESS
  READY
  CANCELLED
}

enum OrderType {
  DINE_IN
  TAKEAWAY
}

enum PaymentMethod {
  CASH
  QRIS
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum StationCode {
  BAR
  KITCHEN
  PASTRY
}

enum StockMoveReason {
  SALE
  REFUND
  OPNAME
  RECEIVE
  ADJUSTMENT
  WASTE
}

enum ShiftStatus {
  OPEN
  CLOSED
}

enum MenuAvailability {
  AVAILABLE
  LOW_STOCK
  UNAVAILABLE
}

model Outlet {
  id            String   @id @default(uuid())
  name          String
  address       String?
  phone         String?
  // Rates are integer basis points: 10000 = 100%, 1100 = 11%.
  taxRate       Int      @default(1100)
  serviceRate   Int      @default(500)
  currency      String   @default("IDR")
  timezone      String   @default("Asia/Jakarta")
  receiptHeader String?
  receiptFooter String?
  lowStockThreshold Int  @default(5)
  varianceThreshold Int @default(10000)
  partialReadyPolicy String @default("WAIT_ALL") // WAIT_ALL | CALL_PER_STATION
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  users         User[]
  shifts        Shift[]
  categories    Category[]
  stations      Station[]
  menus         Menu[]
  ingredients   Ingredient[]
  tickets       Ticket[]
  auditLogs     AuditLog[]
  deviceOutbox  DeviceOutbox[]
  settings      OutletSetting[]
  stockMoves    StockMove[]

  @@index([name])
}

model User {
  id        String   @id @default(uuid())
  outletId  String
  name      String
  pinHash   String
  role      UserRole
  isActive  Boolean  @default(true)
  stationId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  outlet    Outlet   @relation(fields: [outletId], references: [id], onDelete: Cascade)
  // Legacy primary station, kept for compatibility during transition.
  station   Station? @relation("UserPrimaryStation", fields: [stationId], references: [id], onDelete: SetNull)
  // Many-to-many stations (makers may work several stations).
  stations  UserStation[] @relation("UserStationUser")
  shiftsOpened   Shift[] @relation("ShiftOpenedBy")
  shiftsClosed   Shift[] @relation("ShiftClosedBy")
  stockMoves     StockMove[]
  auditLogs      AuditLog[]

  @@unique([outletId, name])
  @@index([outletId])
  @@index([role])
  @@index([stationId])
}

model UserStation {
  userId    String
  stationId String
  createdAt DateTime @default(now())

  user    User    @relation("UserStationUser", fields: [userId], references: [id], onDelete: Cascade)
  station Station @relation("UserStationStation", fields: [stationId], references: [id], onDelete: Cascade)

  @@id([userId, stationId])
  @@index([stationId])
}

model Shift {
  id           String      @id @default(uuid())
  outletId     String
  openedBy     String
  closedBy     String?
  openedAt     DateTime    @default(now())
  closedAt     DateTime?
  openingCash  Int       @default(0)
  expectedCash Int?
  countedCash  Int?
  variance     Int?
  varianceNote String?
  status       ShiftStatus @default(OPEN)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  outlet       Outlet      @relation(fields: [outletId], references: [id], onDelete: Cascade)
  openedByUser User        @relation("ShiftOpenedBy", fields: [openedBy], references: [id])
  closedByUser User?       @relation("ShiftClosedBy", fields: [closedBy], references: [id])
  tickets      Ticket[]
  cashCounts   CashCount[]

  @@index([outletId, status])
  @@index([openedAt])
}

model Category {
  id          String   @id @default(uuid())
  outletId    String
  name        String
  displayOrder Int     @default(0)
  isActive    Boolean  @default(true)
  // Fallback make time (seconds) used until a menu has enough real samples.
  defaultMakeSeconds Int @default(180)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  outlet      Outlet   @relation(fields: [outletId], references: [id], onDelete: Cascade)
  menus       Menu[]

  @@unique([outletId, name])
  @@index([outletId, displayOrder])
}

model Station {
  id          String       @id @default(uuid())
  outletId    String
  code        StationCode
  name        String
  displayOrder Int         @default(0)
  slaMinutes  Int          @default(15)
  isActive    Boolean      @default(true)
  color       String       @default("#2563EB")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  outlet      Outlet       @relation(fields: [outletId], references: [id], onDelete: Cascade)
  menus       Menu[]
  subtickets  SubTicket[]
  staff       User[]          @relation("UserPrimaryStation")
  userStations UserStation[]  @relation("UserStationStation")

  @@unique([outletId, code])
  @@index([outletId, displayOrder])
}

model Menu {
  id              String           @id @default(uuid())
  outletId        String
  categoryId      String
  stationId       String
  name            String
  description     String?
  price           Int              // in smallest currency unit (rupiah)
  imageUrl        String?
  displayOrder    Int              @default(0)
  isActive        Boolean          @default(true)
  availability    MenuAvailability @default(AVAILABLE)
  avgMakeSeconds  Int              @default(180)
  // Number of completed subtickets used to learn avgMakeSeconds.
  // While this is < 5 the category fallback is used instead.
  makeSampleCount Int              @default(0)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  outlet          Outlet           @relation(fields: [outletId], references: [id], onDelete: Cascade)
  category        Category         @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  station         Station          @relation(fields: [stationId], references: [id], onDelete: Cascade)
  recipeLines     RecipeLine[]
  orderItems      OrderItem[]

  @@index([outletId, isActive, stationId])
  @@index([categoryId])
  @@index([stationId])
}

model Ingredient {
  id            String   @id @default(uuid())
  outletId      String
  name          String
  unit          String
  currentQty    Float    @default(0)
  minThreshold  Float    @default(0)
  costPerUnit   Float?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  outlet        Outlet   @relation(fields: [outletId], references: [id], onDelete: Cascade)
  recipeLines   RecipeLine[]
  stockMoves    StockMove[]

  @@unique([outletId, name])
  @@index([outletId])
}

model RecipeLine {
  id              String  @id @default(uuid())
  menuId          String
  ingredientId    String
  qtyPerPortion   Float
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  menu            Menu    @relation(fields: [menuId], references: [id], onDelete: Cascade)
  ingredient      Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@unique([menuId, ingredientId])
  @@index([menuId])
  @@index([ingredientId])
}

model StockMove {
  id          String           @id @default(uuid())
  outletId    String
  ingredientId String
  qtyDelta    Float
  reason      StockMoveReason
  refId       String?
  refType     String?
  createdBy   String
  createdAt   DateTime         @default(now())

  outlet      Outlet           @relation(fields: [outletId], references: [id], onDelete: Cascade)
  ingredient  Ingredient       @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  user        User             @relation(fields: [createdBy], references: [id])

  @@index([outletId, ingredientId, createdAt])
  @@index([refId, refType])
  @@index([reason])
}

model Ticket {
  id              String       @id @default(uuid())
  outletId        String
  shiftId         String
  dailyNo         Int
  ticketNumber    String       // formatted: A-043
  customerName    String?
  orderType       OrderType
  tableNumber     String?
  tableLabel      String?
  // Mobile-generated id, unique per outlet, used as an idempotency key.
  clientTicketId  String?
  status          TicketStatus @default(DRAFT)
  etaMin          Int?
  etaMax          Int?
  subtotal        Int          @default(0)
  taxAmount       Int          @default(0)
  serviceAmount   Int          @default(0)
  discountAmount  Int          @default(0)
  totalAmount     Int          @default(0)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  outlet          Outlet       @relation(fields: [outletId], references: [id], onDelete: Cascade)
  shift           Shift        @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  subtickets      SubTicket[]
  orderItems      OrderItem[]
  payments        Payment[]

  @@unique([shiftId, dailyNo])
  @@unique([ticketNumber, shiftId])
  @@unique([outletId, clientTicketId])
  @@index([outletId, shiftId, status])
  @@index([outletId, createdAt])
  @@index([status])
  @@index([dailyNo])
}

model SubTicket {
  id            String           @id @default(uuid())
  ticketId      String
  stationId     String
  status        SubTicketStatus  @default(ORDERED)
  startedAt     DateTime?
  readyAt       DateTime?
  priorityScore Float            @default(0)
  // Manual maker bumps; each bump lowers the effective score (higher priority).
  priorityBump  Float            @default(0)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  ticket        Ticket           @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  station       Station          @relation(fields: [stationId], references: [id], onDelete: Cascade)
  orderItems    OrderItem[]

  @@index([ticketId])
  @@index([stationId, status])
  @@index([stationId, priorityScore])
}

model OrderItem {
  id            String   @id @default(uuid())
  ticketId      String
  menuId        String
  subticketId   String?
  qty           Int
  priceSnapshot Int
  note          String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  ticket        Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  menu          Menu     @relation(fields: [menuId], references: [id], onDelete: Cascade)
  subticket     SubTicket? @relation(fields: [subticketId], references: [id], onDelete: SetNull)

  @@index([ticketId])
  @@index([menuId])
  @@index([subticketId])
}

model Payment {
  id            String         @id @default(uuid())
  ticketId      String
  method        PaymentMethod
  amount        Int
  status        PaymentStatus  @default(PENDING)
  splitGroupId  String?
  qrisRef       String?
  qrisPayload   Json?
  idempotencyKey String?       @unique
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  ticket        Ticket         @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([qrisRef])
  @@index([splitGroupId])
  @@index([status])
}

model CashCount {
  id          String  @id @default(uuid())
  shiftId     String
  denomination Int
  count       Int
  createdAt   DateTime @default(now())

  shift       Shift   @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  @@unique([shiftId, denomination])
}

model AuditLog {
  id        String   @id @default(uuid())
  outletId  String
  actorId   String?
  action    String
  entity    String
  entityId  String
  diff      Json?
  metadata  Json?
  createdAt DateTime @default(now())

  outlet    Outlet   @relation(fields: [outletId], references: [id], onDelete: Cascade)
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([outletId, entity, entityId])
  @@index([outletId, createdAt])
  @@index([actorId])
}

model PinAttempt {
  id            String    @id @default(uuid())
  outletId      String
  // MANAGER (userId = "") atau LOGIN (userId = user id)
  kind          String
  userId        String    @default("")
  ip            String    @default("")
  attempts      Int       @default(0)
  lockLevel     Int       @default(0) // 0 = none, 1 = short lock, 2 = long lock
  lockedUntil   DateTime?
  lastAttemptAt DateTime  @default(now())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([kind, outletId, userId, ip])
  @@index([outletId])
}

model RefreshToken {
  id             String    @id @default(uuid())
  userId         String
  tokenHash      String    @unique
  familyId       String
  expiresAt      DateTime
  revokedAt      DateTime?
  replacedByHash String?
  createdAt      DateTime  @default(now())

  @@index([userId])
  @@index([familyId])
}

model IdempotencyKey {
  id          String   @id @default(uuid())
  outletId    String
  key         String
  requestHash String
  ticketId    String?
  createdAt   DateTime @default(now())

  @@unique([outletId, key])
  @@index([ticketId])
}

model DeviceOutbox {
  id          String   @id @default(uuid())
  outletId    String
  deviceId    String
  payload     Json
  seq         Int
  status      String   @default("pending") // pending | synced | failed
  lastAttemptAt DateTime?
  error       String?
  createdAt   DateTime @default(now())

  outlet      Outlet   @relation(fields: [outletId], references: [id], onDelete: Cascade)

  @@unique([deviceId, seq])
  @@index([outletId, status])
  @@index([deviceId])
}

model OutletSetting {
  id        String   @id @default(uuid())
  outletId  String   @unique
  key       String
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  outlet    Outlet   @relation(fields: [outletId], references: [id], onDelete: Cascade)

  @@unique([outletId, key])
}