# Database
DATABASE_URL="postgresql://orderq:orderq_dev_password@localhost:5432/orderq?schema=public"
# Integration tests REQUIRE a separate database and will refuse to run if empty or equal to DATABASE_URL
DATABASE_URL_TEST="postgresql://orderq:orderq_dev_password@localhost:5432/orderq_test?schema=public"

# Redis (optional; the API does not use Redis today)
REDIS_URL="redis://localhost:6379"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-in-production-min-32-chars"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# App
NODE_ENV="development"
PORT=3000
API_PREFIX="v1"
# Public base URL (used for QRIS callbacks)
APP_URL="http://localhost:3000"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# PIN Lockout (persistent, stored in the PinAttempt table)
PIN_MAX_ATTEMPTS=5
PIN_SHORT_LOCK_MINUTES=1
PIN_LOCKOUT_MINUTES=15

# CORS allowlist (comma-separated). Empty means no cross-origin access in production.
CORS_ORIGINS=""
# Swagger /docs is disabled in production unless ENABLE_DOCS=true
ENABLE_DOCS=false

# Printer (optional for dev)
PRINTER_ENABLED=false
PRINTER_TYPE="bluetooth" # bluetooth | network
PRINTER_MAC_ADDRESS=""
PRINTER_IP=""
PRINTER_PORT=9100

# QRIS (Phase 2)
# Development: keep QRIS_ENABLED=false to use the mock gateway (webhook simulation only in non-production).
# Production: QRIS_ENABLED=true is REQUIRED; the API refuses to boot without it and without the three values below.
QRIS_ENABLED=false
QRIS_MERCHANT_ID=""
QRIS_API_KEY=""
QRIS_WEBHOOK_SECRET=""
# QRIS payment expiry (minutes) and sweep interval (ms)
QRIS_EXPIRY_MINUTES=5
QRIS_SWEEP_INTERVAL_MS=60000

# Socket.IO
SOCKET_CORS_ORIGIN="*"
